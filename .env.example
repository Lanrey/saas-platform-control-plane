# ============================================================
# Platform Management API — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database — PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=platform_mgmt
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# JWT — RS256 (asymmetric keys)
# Generate: openssl genrsa -out private.pem 2048
#           openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# OR inline (base64-encoded, for Docker/cloud deployments):
# JWT_PRIVATE_KEY_BASE64=
# JWT_PUBLIC_KEY_BASE64=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=platform-mgmt-api
JWT_AUDIENCE=platform-mgmt-clients

# OAuth 2.0
OAUTH_AUTH_CODE_TTL_SECONDS=600
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# API Keys
API_KEY_PREFIX=pmk_
API_KEY_ENTROPY_BYTES=32
# SHA-256 is used for storage; plaintext is never persisted

# Rate Limiting (per API key)
RATE_LIMIT_DEFAULT_RPM=60
RATE_LIMIT_DEFAULT_RPD=10000
# Redis is used for distributed rate limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
# LOG_LEVEL options: trace, debug, info, warn, error, fatal

# Security
HELMET_ENABLED=true
REQUEST_ID_HEADER=X-Request-ID

# Metrics
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Basic auth for /metrics endpoint (optional)
METRICS_BASIC_AUTH_USER=metrics
METRICS_BASIC_AUTH_PASSWORD=
